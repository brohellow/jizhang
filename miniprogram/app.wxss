/* 全局样式 */
page {
  background: #f4f6fa;
  font-size: 28rpx;
  color: #1f2937;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
}

.card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(16, 24, 40, 0.06);
}

.btn-primary {
  background: #3b82f6;
  color: #ffffff;
  border-radius: 12rpx;
  font-size: 30rpx;
  padding: 18rpx 0;
  text-align: center;
}
.btn-primary:active { opacity: 0.85; }

.btn-ghost {
  background: #ffffff;
  color: #1f2937;
  border: 1rpx solid #e5e9f0;
  border-radius: 12rpx;
  font-size: 28rpx;
  padding: 14rpx 0;
  text-align: center;
}

.btn-danger {
  background: #fef2f2;
  color: #dc2626;
  border: 1rpx solid #fecaca;
  border-radius: 12rpx;
  font-size: 26rpx;
  padding: 8rpx 20rpx;
}

.input-box {
  background: #ffffff;
  border: 1rpx solid #e5e9f0;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
  width: 100%;
  box-sizing: border-box;
}

.row { display: flex; align-items: center; }
.muted { color: #8a94a6; font-size: 24rpx; }
.income { color: #16a34a; }
.expense { color: #dc2626; }
.empty { color: #8a94a6; text-align: center; padding: 60rpx 0; }
