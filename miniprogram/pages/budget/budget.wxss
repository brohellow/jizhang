.page { padding-bottom: 40rpx; }
.topbar { padding: 20rpx 24rpx 0; }
.top-item { background: #fff; border-radius: 12rpx; padding: 14rpx 24rpx; font-size: 28rpx; display: inline-block; box-shadow: 0 2rpx 8rpx rgba(16,24,40,.06); }
.section-title { font-size: 30rpx; font-weight: 600; margin-bottom: 16rpx; }
.progress { height: 16rpx; background: #eef2f7; border-radius: 99rpx; overflow: hidden; margin: 10rpx 0; }
.progress-bar { height: 100%; background: #3b82f6; border-radius: 99rpx; }
.progress-bar.warn { background: #f59e0b; }
.progress-bar.over { background: #dc2626; }
.budget-info { display: flex; justify-content: space-between; font-size: 24rpx; color: #8a94a6; margin-top: 6rpx; }
.btns { gap: 16rpx; margin-top: 20rpx; }
.flex1 { flex: 1; }
.set-btn { padding: 16rpx 30rpx; margin-left: 16rpx; }
.budget-item { display: flex; gap: 16rpx; padding: 16rpx 0; border-bottom: 1rpx solid #f1f5f9; }
.b-icon { font-size: 36rpx; }
.b-main { flex: 1; }
.b-name { font-size: 28rpx; }
.col-actions { display: flex; flex-direction: column; gap: 10rpx; }
.sm { padding: 8rpx 18rpx; font-size: 24rpx; }
.add-row { margin-top: 24rpx; }
.cat-pick { width: 280rpx; }
