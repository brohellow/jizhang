.page { padding-bottom: 40rpx; }
.topbar { display: flex; justify-content: space-between; padding: 20rpx 24rpx 0; }
.top-item { background: #fff; border-radius: 12rpx; padding: 14rpx 24rpx; font-size: 28rpx; box-shadow: 0 2rpx 8rpx rgba(16,24,40,.06); }
.type-toggle { display: flex; background: #f4f6fa; border-radius: 12rpx; padding: 6rpx; margin-bottom: 20rpx; }
.type-btn { flex: 1; text-align: center; padding: 14rpx 0; border-radius: 10rpx; color: #8a94a6; }
.type-btn.active.exp { background: #fff; color: #dc2626; font-weight: 600; }
.type-btn.active.inc { background: #fff; color: #16a34a; font-weight: 600; }
.form-row { gap: 16rpx; margin-bottom: 20rpx; }
.amount { flex: 1; font-size: 34rpx; font-weight: 600; }
.date { width: 220rpx; text-align: center; }
.cat-grid { display: flex; flex-wrap: wrap; gap: 14rpx; margin-bottom: 20rpx; }
.cat-item { width: calc(25% - 12rpx); box-sizing: border-box; border: 1rpx solid #e5e9f0; border-radius: 12rpx; padding: 16rpx 0; text-align: center; background: #fff; }
.cat-item.selected { border-color: #3b82f6; background: #eff6ff; color: #2563eb; }
.cat-icon { display: block; font-size: 36rpx; }
.cat-name { display: block; font-size: 22rpx; margin-top: 4rpx; }
.empty.small { width: 100%; padding: 20rpx 0; }
.note { margin-bottom: 20rpx; }
.save { margin-bottom: 12rpx; }
.cancel { margin-bottom: 4rpx; }
.list-title { font-size: 30rpx; font-weight: 600; margin-bottom: 8rpx; }
.rec-item { display: flex; align-items: center; padding: 18rpx 0; border-bottom: 1rpx solid #f1f5f9; }
.rec-icon { font-size: 36rpx; margin-right: 18rpx; }
.rec-main { flex: 1; min-width: 0; }
.rec-name { font-size: 28rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.rec-date { font-size: 22rpx; margin-top: 2rpx; }
.rec-amount { font-size: 30rpx; font-weight: 600; margin-right: 16rpx; }
.rec-del { color: #dc2626; font-size: 24rpx; padding: 8rpx 12rpx; }
.more { margin-top: 20rpx; }
