.page { padding-bottom: 40rpx; }
.topbar { padding: 20rpx 24rpx 0; }
.top-item { background: #fff; border-radius: 12rpx; padding: 14rpx 24rpx; font-size: 28rpx; display: inline-block; box-shadow: 0 2rpx 8rpx rgba(16,24,40,.06); }
.stat-row { display: flex; gap: 16rpx; }
.stat-row.second { margin-top: 20rpx; }
.stat { flex: 1; background: #f8fafc; border: 1rpx solid #e5e9f0; border-radius: 14rpx; padding: 20rpx; text-align: center; }
.stat-label { font-size: 22rpx; }
.stat-value { font-size: 34rpx; font-weight: 700; margin-top: 6rpx; }
.chart-title { font-size: 30rpx; font-weight: 600; margin-bottom: 16rpx; }
.chart { width: 100%; height: 360rpx; }
.chart.pie { height: 400rpx; }
.legend-item { display: flex; align-items: center; margin-top: 14rpx; font-size: 26rpx; }
.legend-dot { width: 20rpx; height: 20rpx; border-radius: 50%; margin-right: 14rpx; }
.legend-name { flex: 1; }
.legend-val { color: #8a94a6; font-size: 24rpx; }
